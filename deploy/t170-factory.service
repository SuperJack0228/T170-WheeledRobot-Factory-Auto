[Unit]
Description=T170 Factory production service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ti5robot
Group=ti5robot
ExecStartPre=/bin/sleep 8
EnvironmentFile=/etc/t170-factory/runtime.env
ExecStart=/bin/bash -c 'exec "$T170_INSTALL_ROOT/deploy/run_production.sh"'
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
