function(t170_add_vendor_arm)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "Vendor arm binaries are Linux ELF. Use T170_SERVO_TESTS_ONLY on macOS.")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
        set(sdk_arch aarch64)
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
        set(sdk_arch x86_64)
    else()
        message(FATAL_ERROR "No vendor arm SDK for ${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    set(TI5_ARM_SDK_PLATFORM "${sdk_arch}-glibc227" CACHE STRING "Vendor arm SDK platform")
    if(NOT TI5_ARM_SDK_PLATFORM MATCHES "^${sdk_arch}-")
        message(FATAL_ERROR "Arm SDK platform does not match target architecture")
    endif()
    set(sdk_lib "${T170_ARM_LIBRARY_DIR}/${TI5_ARM_SDK_PLATFORM}/libti5_robot.so")
    if(NOT EXISTS "${sdk_lib}")
        message(FATAL_ERROR "Missing vendor arm SDK: ${sdk_lib}")
    endif()
    add_library(t170_arm_vendor STATIC src/motion/vendor_arm.cpp)
    target_include_directories(t170_arm_vendor PRIVATE ${T170_ARM_INCLUDE_DIR})
    target_link_libraries(t170_arm_vendor PUBLIC t170_arm_core "${sdk_lib}")
    file(WRITE "${CMAKE_BINARY_DIR}/arm_sdk_platform.txt" "${TI5_ARM_SDK_PLATFORM}\n")
    set(TI5_ARM_SOLVER_LIB "${sdk_lib}" PARENT_SCOPE)
    get_filename_component(sdk_directory "${sdk_lib}" DIRECTORY)
    set(TI5_ARM_SOLVER_DIRECTORY "${sdk_directory}" PARENT_SCOPE)
endfunction()
