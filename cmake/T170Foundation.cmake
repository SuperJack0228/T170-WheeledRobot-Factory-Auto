# First-step modules contain one implementation each. No runtime/SDK in control or math.
if(NOT TARGET Eigen3::Eigen)
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    target_include_directories(Eigen3::Eigen INTERFACE "${PROJECT_SOURCE_DIR}/eigen3")
endif()
add_library(t170_common STATIC src/common/paths.cpp src/common/logging.cpp src/common/servo_types.cpp
    src/common/task_timing.cpp)
add_library(t170::common ALIAS t170_common)
target_include_directories(t170_common PUBLIC ${PROJECT_SOURCE_DIR}/include)
target_link_libraries(t170_common PUBLIC Eigen3::Eigen)
target_compile_definitions(t170_common PRIVATE T170_SOURCE_ROOT="${PROJECT_SOURCE_DIR}")

add_library(t170_model_registry STATIC src/vision/detection/model_registry.cpp)
add_library(t170::model_registry ALIAS t170_model_registry)
target_include_directories(t170_model_registry PUBLIC ${PROJECT_SOURCE_DIR}/include)
target_link_libraries(t170_model_registry PUBLIC t170::common)

add_library(t170_control STATIC src/control/visual_servo.cpp)
add_library(t170::control ALIAS t170_control)
target_include_directories(t170_control PUBLIC ${PROJECT_SOURCE_DIR}/include)
target_link_libraries(t170_control PUBLIC t170::common)

add_library(t170_motion_math STATIC src/motion/pose_solver.cpp src/motion/joint_motion.cpp)
add_library(t170::motion_math ALIAS t170_motion_math)
target_include_directories(t170_motion_math PUBLIC ${PROJECT_SOURCE_DIR}/include)
target_link_libraries(t170_motion_math PUBLIC t170::control)

# Transitional name, not a second implementation.
add_library(t170_servo_core INTERFACE)
add_library(t170::servo_core ALIAS t170_servo_core)
target_link_libraries(t170_servo_core INTERFACE t170::motion_math)

function(t170_add_configuration)
    add_library(t170_configuration STATIC src/common/config.cpp src/servo/config.cpp)
    target_compile_definitions(t170_configuration PRIVATE T170_BUILD_CONFIGURATION="${CMAKE_BUILD_TYPE}")
    add_library(t170::configuration ALIAS t170_configuration)
    target_include_directories(t170_configuration PUBLIC ${PROJECT_SOURCE_DIR}/include)
    target_link_libraries(t170_configuration PUBLIC t170::common t170::control)
    if(TARGET yaml-cpp::yaml-cpp)
        target_link_libraries(t170_configuration PUBLIC yaml-cpp::yaml-cpp)
    else()
        target_link_libraries(t170_configuration PUBLIC yaml-cpp)
    endif()
endfunction()

function(t170_add_observation_support)
    add_library(t170_servo_trace STATIC src/common/servo_trace.cpp)
    add_library(t170::servo_trace ALIAS t170_servo_trace)
    target_include_directories(t170_servo_trace PUBLIC ${PROJECT_SOURCE_DIR}/include)
    target_link_libraries(t170_servo_trace PUBLIC t170::common Threads::Threads)
    add_library(t170_tray_geometry STATIC src/vision/geometry/tray_localizer.cpp src/vision/geometry/calibration_hole.cpp
        src/vision/geometry/tray_registration.cpp)
    add_library(t170::tray_geometry ALIAS t170_tray_geometry)
    target_include_directories(t170_tray_geometry PUBLIC ${PROJECT_SOURCE_DIR}/include ${OpenCV_INCLUDE_DIRS})
    target_link_libraries(t170_tray_geometry PUBLIC t170::common ${OpenCV_LIBS})
    if(TARGET yaml-cpp::yaml-cpp)
        target_link_libraries(t170_tray_geometry PUBLIC yaml-cpp::yaml-cpp)
    else()
        target_link_libraries(t170_tray_geometry PUBLIC yaml-cpp)
    endif()
endfunction()
